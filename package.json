{
  "name": "hcom-plugin-typecheck",
  "private": true,
  "description": "Type-checks the embedded agent plugins against their upstream SDK types.",
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:plugins": "node --experimental-strip-types --experimental-test-module-mocks --test tests/plugin_delivery.test.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@kilocode/plugin": "7.8.8",
    "@oh-my-pi/pi-coding-agent": "18.10.2",
    "@opencode-ai/plugin": "1.19.0",
    "@opencode-ai/sdk": "1.19.0",
    "@opencode/plugin": "2.0.27",
    "@types/bun": "1.4.3",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "overrides": {
    "onnxruntime-node": {
      "global-agent": "4.1.3"
    }
  }
}
